{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonata",
  "version": "0.1.0",
  "identifier": "com.sonata.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sonata",
        "width": 760,
        "height": 900,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
