{
  "name": "sonata",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev --features desktop",
    "dev:ui": "vite",
    "build": "tsc -b && vite build",
    "build:windows": "tauri build --target x86_64-pc-windows-msvc --features desktop,custom-protocol",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "tauri": "tauri",
    "build:menu": "bash scripts/build.sh"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "jsdom": "^26.0.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^8.2.0",
    "vitest": "^3.0.8"
  }
